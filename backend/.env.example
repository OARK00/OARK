# development | test | production. Must match the label inside the database
# (label_database.py). Local copies use a separate development database and
# never hold the production DATABASE_URL or JWT_SECRET.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/oark
JWT_SECRET=change-this-to-a-long-random-string

# true: the web API also runs the MQTT listener (one process, free-tier setup).
# false: the listener runs as its own service (python listener.py), so
# deploying or restarting the API cannot interrupt device data.
INGESTION_IN_API=true

MQTT_HOST=localhost
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=

# AI drafting of products ("Describe your device"). Get a key at
# aistudio.google.com. Leave empty to disable: the app shows the feature as
# unavailable and nothing else changes. Free-tier requests may be used by
# Google to improve its products; use a paid key before real customers.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Tried when the primary is busy (503/500/timeout); each model has its own capacity.
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
AI_DRAFTS_PER_HOUR=20

# EMQX Deployment API key (Deployment Overview > Deployment API Key)
EMQX_API_URL=https://your-deployment:8443/api/v5
EMQX_API_KEY=
EMQX_API_SECRET=
